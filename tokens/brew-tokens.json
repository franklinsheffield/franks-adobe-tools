{
  "$description": "Frank's Brew suite design tokens (W3C DTCG format 2025.10). One source for the Photoshop panels (shared/panel.css + plugins/*/styles.css), the After Effects effects and the Worlds Brew app. tests/tokens.js checks the panels match.",
  "color": {
    "ink": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0,
          0.0,
          0.0
        ],
        "hex": "#000000"
      },
      "$description": "Panel background (Hardware Console)"
    },
    "stroke": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "alpha": 0.85,
        "hex": "#ffffff"
      },
      "$description": "Thin white strokes around boxes and buttons"
    },
    "soft": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "alpha": 0.35,
        "hex": "#ffffff"
      },
      "$description": "Dividers and secondary borders"
    },
    "select": {
