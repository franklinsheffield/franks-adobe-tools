<?xml version="1.0" encoding="UTF-8"?>
<!-- Frank's Brew Console for After Effects (CEP 12, AE 2027). Free install: see ae/tools/install-console-mac.command -->
<ExtensionManifest Version="7.0" ExtensionBundleId="com.franks.brewconsole" ExtensionBundleVersion="1.0.0" ExtensionBundleName="Frank's Brew Console"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.franks.brewconsole.panel" Version="1.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[24.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.franks.brewconsole.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Frank's Brew Console</Menu>
          <Geometry>
            <Size><Height>720</Height><Width>340</Width></Size>
            <MinSize><Height>300</Height><Width>260</Width></MinSize>
            <MaxSize><Height>2400</Height><Width>1200</Width></MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./icons/panel.png</Icon>
            <Icon Type="RollOver">./icons/panel.png</Icon>
            <Icon Type="DarkNormal">./icons/panel.png</Icon>
            <Icon Type="DarkRollOver">./icons/panel.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
