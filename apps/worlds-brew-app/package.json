{
  "name": "franks-worlds-brew",
  "productName": "Pixel Scape",
  "version": "0.12.0",
  "description": "Pixel Scape (PX-10): standalone 3D scene builder",
  "main": "main.js",
  "private": true,
  "scripts": {
    "sync": "node tools/sync-engine.js",
    "start": "npm run sync && electron .",
    "test": "node tests/app-tests.js",
    "dist:mac": "npm run sync && electron-builder --mac --publish never",
    "dist:win": "npm run sync && electron-builder --win zip --x64 --publish never",
    "web": "npm run sync && node web/build.js",
    "web:serve": "node web/serve.js",
    "web:smoke": "node web/smoke.js"
  },
  "dependencies": {
    "earcut": "2.2.4",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "buffer": "^6.0.3",
    "electron": "38.2.0",
    "electron-builder": "26.0.12",
    "esbuild": "^0.25.10",
    "fflate": "^0.8.2",
    "path-browserify": "^1.0.1"
  },
  "build": {
    "appId": "com.franks.worldsbrew.app",
    "productName": "Pixel Scape",
    "files": [
      "main.js",
      "geo/**",
      "renderer/**",
      "engine/**",
      "node_modules/three/build/**",
      "node_modules/three/package.json",
      "node_modules/three/LICENSE",
      "node_modules/earcut/package.json",
      "node_modules/earcut/src/**",
      "node_modules/earcut/LICENSE"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png"
    },
    "directories": {
      "output": "dist"
    },
    "publish": []
  }
}
